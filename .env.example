# ============================================================================
# GeM Tender SaaS — Environment Variables Template
# Copy this file to .env and update values for local development
# ============================================================================

# --- Database ---
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgresql+asyncpg://gem:devpass@localhost:5432/gem_tender
SYNC_DATABASE_URL=postgresql://gem:devpass@localhost:5432/gem_tender

# --- Redis & Message Queue ---
REDIS_URL=redis://localhost:6379/0

# --- API & Auth ---
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
API_ROOT_PATH=/api

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- S3 / R2 Object Storage ---
# For Cloudflare R2 (recommended): https://<account-id>.r2.cloudflarestorage.com
# For AWS S3: https://s3.ap-south-1.amazonaws.com
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gem-tender-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1

# --- Scraper ---
HEADLESS=true
DOWNLOAD_DIR=/tmp/gem_pdfs

# --- Proxies (for anti-bot scraping) ---
# Placeholder: set to actual proxy URLs when available
PROXY_URLS=

# --- AI / Claude API ---
CLAUDE_API_KEY=

# --- Monitoring & Logging ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Feature Flags ---
ENABLE_SCHEDULING=true
ENABLE_PDF_EXTRACTION=true
ENABLE_S3_UPLOAD=false

# --- Email (Resend) ---
# Get a free API key at https://resend.com — required for alert digests
RESEND_API_KEY=
EMAIL_FROM=GeM Tender <noreply@gemtender.com>

# --- App Base URL (used in digest email links) ---
APP_BASE_URL=http://localhost:3000

# --- Outbound Webhooks ---
# Timeout in seconds for delivering outbound webhook POSTs
WEBHOOK_TIMEOUT_SECONDS=10
