# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgresql+asyncpg://gem:devpass@postgres:5432/gem_tender
SYNC_DATABASE_URL=postgresql://gem:devpass@postgres:5432/gem_tender

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://redis:6379

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
DEBUG=false
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================================================
# Data Directories
# Host path for keys volume: ${DATA_DIR}/keys is mounted read-only into containers as /keys
# On Windows with Docker Desktop use forward slashes
# ============================================================================
DATA_DIR=./data
DOWNLOAD_DIR=/pdfs

# ============================================================================
# Clerk Authentication
# Using development instance: firm-stallion-78.clerk.accounts.dev
# NOTE: CLERK_SECRET_KEY must match the instance that issued CLERK_JWKS_URL.
#       The sk_live_ key found in the old API section belongs to a different
#       production Clerk instance — do NOT mix sk_live_ with pk_test_ keys.
# ============================================================================
CLERK_SECRET_KEY=sk_test_XG8BXk5PXcnUPmrRtnRzznYA4vumvT4p4YUFI0kjhM
CLERK_JWKS_URL=https://firm-stallion-78.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://firm-stallion-78.clerk.accounts.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZmlybS1zdGFsbGlvbi03OC5jbGVyay5hY2NvdW50cy5kZXYk

# ============================================================================
# PhonePe Payment Gateway (Sandbox / Preprod)
# Switch to production when ready:
#   PHONEPE_AUTH_BASE_URL=https://api.phonepe.com/apis
#   PHONEPE_PG_BASE_URL=https://api.phonepe.com/apis/pg
# ============================================================================
PHONEPE_CLIENT_ID=M23ZJ2OVPWFJV_2603070950
PHONEPE_CLIENT_SECRET=M2NhNWFjYWMtOTFmYS00NTc3LTg2OTYtMTU2MWJkMDEwODE3
PHONEPE_CLIENT_VERSION=1
PHONEPE_AUTH_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_PG_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
# ngrok tunnel for local PhonePe webhook callbacks — update when tunnel changes
PHONEPE_WEBHOOK_BASE_URL=https://cataclinal-draven-unbeaming.ngrok-free.dev

# ============================================================================
# Google Cloud Storage (GCS)
# S3_ACCESS_KEY / S3_SECRET_KEY: leave empty when using GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_APPLICATION_CREDENTIALS is mounted via DATA_DIR/keys volume
# ============================================================================
S3_ENDPOINT=https://storage.googleapis.com
S3_BUCKET=gem-tender-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/keys/gcs-key.json

# ============================================================================
# Licensing
# ============================================================================
LICENSE_ACTIVE_KID=v1
LICENSE_PRIVATE_KEY_PATH=/keys/signing_private_v1.pem
LICENSE_PUBLIC_KEY_PATH=/keys/signing_public_v1.pem
LICENSING_MODE=off
LOCAL_ADMIN_USER_IDS=["1"]
